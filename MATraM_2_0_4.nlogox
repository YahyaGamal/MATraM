    <experiment name="260218_Scale" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= 18000]]></exitCondition>
      <runMetricsCondition>ticks = 18000</runMetricsCondition>
      <metrics>
        <metric>all-delays</metric>
        <metric>all-periods</metric>
        <metric>count cars with [modify? = true]</metric>
        <metric>ifelse-value (any? cars) [(count cars with [modify? = true] / count cars) * 100] [0]</metric>
        <metric>activity-record</metric>
        <metric>weight-record</metric>
        <metric>delay-record</metric>
        <metric>threshold-record</metric>
        <metric>period-record</metric>
        <metric>current-seed</metric>
