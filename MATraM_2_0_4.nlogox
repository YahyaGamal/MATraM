        <enumeratedValueSet variable="return-home?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="number_of_vehicles" first="100" step="100" last="500"></steppedValueSet>
        <enumeratedValueSet variable="max-n-activities">
          <value value="4"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="slowest-vehicle" first="0.1" step="0.1" last="0.5"></steppedValueSet>
