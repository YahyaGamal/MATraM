<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="true">
  <code><![CDATA[; Include any necessary libraries
extensions [ nw  csv string ]
__includes ["buses.nls" "cars.nls" "nodes.nls" "buildings.nls" "pedestrians.nls" "global_functions.nls"]

; monitors
globals [
  all-periods
  all-delays
  n-trips-list
  model-to-mile-factor
  mile-to-model-factor
  
  activity-record
  delay-record
  threshold-record
  weight-record
  period-record
  modify-record
  modify-car-record
  modify-pedestrian-walk-record
  modify-pedestrian-public-transport-record
]


; Set up the simulation
to setup
  ifelse control-seed? 
  [random-seed current-seed]
  [
    set current-seed new-seed
    random-seed current-seed
  ]
  clear-all  ; Clear any existing data
  set all-periods (list)
  set all-delays (list)
  set n-trips-list (list)
  ask patches[ set pcolor white ]
  load-network
  load-buildings
  load-buses
  init-buses-parameters-network
  cars-init number-of-cars ; Initialize vehicles
  pedestrians-init number-of-pedestrians
  let vehicles (turtle-set cars buses)
  ask vehicles [if b-destinations != 0 [set n-trips-list lput (length b-destinations) (n-trips-list)] ]
  reset-ticks ; Reset the tick counter
  reset-timer
;  go
end


; Advance the simulation by one tick
to go
  let flag true
;  carefully [
    ask roads [
      set current_speeds (list)
    ]
    let vehicles (turtle-set cars buses)
    ask vehicles [
      let pre-period periods
      let pre-delay delays
      vehicles-move ; Move the vehicles
      let post-period periods
      let post-delay delays
      if is-car? self and pre-period != post-period [
        set all-periods lput (last post-period) (all-periods)
        set all-delays lput (last post-delay) (all-delays)
      ]
      if active? = true [set flag false]
    ]
    ask pedestrians [
      pedestrians-move
      if active? = true [set flag false]
    ]
    if flag = true [
      ;    if ticks > 0 [type timer type "\n"]
      stop
    ]
    buses-start-SPs
    update-SPs
;    if count cars = 0 and count pedestrians = 0 [stop]
    tick ; Advance the tick counter
;  ]
  
;  [
;    error (word
;      "Failure: run=" behaviorspace-run-number
;      ", seed=" current-seed
;      ", ticks=" ticks
;      ", number-of-cars=" number-of-cars
;      ", number-of-pedestrians=" number-of-pedestrians
;      "\n Error message: " error-message
;    )
;  ]
;  
  ;; added as carefully does not allow behaviour space runs to stop
  if flag = true [stop]
end

to go-infinite
  let flag true
  let vehicles (turtle-set cars buses)
  ask vehicles [
    let pre-period periods
    let pre-delay delays
    vehicles-move ; Move the vehicles
    let post-period periods
    let post-delay delays
    if pre-period != post-period [
      set all-periods lput (last post-period) (all-periods)
      set all-delays lput (last post-delay) (all-delays)
    ]
    if active? = true[
      set flag false
    ]
  ]
  ask pedestrians [
    pedestrians-move
    if active? = true [set flag false]
  ]
  buses-start-SPs
  update-SPs
  tick ; Advance the tick counter
  if flag = true [
;    if ticks > 0 [type timer type "\n"]
    if control-seed? [set current-seed current-seed + 1]
    setup
  ]

end


; Public Domain:
; adapted from code by Uri Wilensky
; To the extent possible under law, ric colasanti has waived all
; copyright and related or neighboring rights to this model.]]></code>
