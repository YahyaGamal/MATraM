setup</previewCommands>
  <experiments>
    <experiment name="250327 OAT SA" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>times</metric>
        <metric>count vehicles with [modify? = true]</metric>
        <metric>count vehicles with [modify? = true] / count vehicles</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="return-home?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="number_of_vehicles" first="100" step="100" last="500"></steppedValueSet>
        <enumeratedValueSet variable="max-n-activities">
          <value value="4"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="slowest-vehicle" first="0.1" step="0.1" last="0.5"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="250327 OAT SA (dummy data)" repetitions="4" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>times</metric>
        <metric>count vehicles with [modify? = true]</metric>
        <metric>(count vehicles with [modify? = true] / count vehicles) * 100</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="return-home?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="number_of_vehicles" first="100" step="100" last="500"></steppedValueSet>
        <enumeratedValueSet variable="max-n-activities">
          <value value="4"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="slowest-vehicle" first="0.1" step="0.1" last="0.5"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="250327 baseline" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false">
